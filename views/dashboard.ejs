<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <title>KDU Automation Dashboard</title>
  <meta http-equiv="refresh" content="10"> <!-- Auto-refresh every 10 seconds -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .badge-category { font-size: 0.85em; }
    .table-hover tbody tr:hover td { background-color: rgba(255, 255, 255, 0.05) !important; }
    .card { border-color: #444; }
  </style>
</head>
<body>
<div class="container my-5">
  <h1 class="mb-4">KDU Automation Dashboard</h1>

  <!-- Memories Section -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white border-bottom border-secondary">
      <h5 class="mb-0">🧠 Aktif Kurallar (Memories / RLHF)</h5>
    </div>
    <div class="card-body">
      <% if (memories.length === 0) { %>
        <p class="text-muted mb-0">Henüz hiç kural/hafıza yok.</p>
      <% } else { %>
        <ul class="list-group">
          <% memories.forEach(mem => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <strong>Kural:</strong> <%= mem.rule %><br>
                <small class="text-muted">Sonuç Kategori: <%= mem.correctedCategory %></small>
              </div>
              <form action="/dashboard/memory/delete" method="POST" style="margin: 0;">
                <input type="hidden" name="memoryId" value="<%= mem.id %>">
                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <!-- Awaiting Approval Section -->
  <div class="card mb-4 border-warning">
    <div class="card-header bg-warning text-dark border-bottom border-secondary">
      <h5 class="mb-0">⏳ Onay Bekleyenler (Düzeltme Sonrası AI Çıktısı)</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover table-dark mb-0">
        <thead>
          <tr>
            <th>Müşteri</th>
            <th>Kategori</th>
            <th>Görev Özeti & Başlık</th>
            <th>Aciliyet</th>
            <th>Öğrenilen Kural</th>
            <th>İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% if (awaitingTasks.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">Onay bekleyen görev yok.</td></tr>
          <% } %>
          <% awaitingTasks.forEach(task => { %>
            <tr>
              <td><strong><%= task.clientName || 'Bilinmiyor' %></strong></td>
              <td><span class="badge bg-secondary badge-category"><%= task.category || 'Yok' %></span></td>
              <td>
                <div class="fw-bold text-light"><%= task.standardisedTitle || task.title %></div>
                <div class="text-secondary small"><%= task.summary || task.body %></div>
                <div class="text-secondary small" style="font-size:0.7em;">Orijinal Text: <%= task.title %> - <%= task.body %></div>
              </td>
              <td>
                <% if(task.urgency === 'Yüksek') { %>
                  <span class="badge bg-danger"><%= task.urgency %></span>
                <% } else if(task.urgency === 'Orta') { %>
                  <span class="badge bg-warning text-dark"><%= task.urgency %></span>
                <% } else { %>
                  <span class="badge bg-info"><%= task.urgency %></span>
                <% } %>
              </td>
              <td>
                <div class="text-info small fst-italic"><%= task.learnedRule || 'Kural belirtilmemiş' %></div>
              </td>
              <td>
                <form action="/dashboard/approve" method="POST">
                  <input type="hidden" name="taskId" value="<%= task.id %>">
                  <input type="hidden" name="rule" value="<%= task.learnedRule || '' %>">
                  <input type="hidden" name="category" value="<%= task.category || 'Genel' %>">
                  <input type="hidden" name="clientId" value="<%= task.clientId || '' %>">
                  <button type="submit" class="btn btn-sm btn-success w-100">Kuralı Onayla & Görevi Bitir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tasks Section -->
  <div class="card shadow-sm">
    <div class="card-header bg-dark text-white border-bottom border-secondary">
      <h5 class="mb-0">✅ Son İşlenen Görevler (Canlı)</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover table-dark mb-0">
        <thead>
          <tr>
            <th>Müşteri</th>
            <th>Kategori</th>
            <th>Görev Özeti & Başlık</th>
            <th>Aciliyet</th>
            <th>İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% if (tasks.length === 0) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">Henüz işlenmiş görev yok.</td></tr>
          <% } %>
          <% tasks.forEach(task => { %>
            <tr>
              <td><strong><%= task.clientName || 'Bilinmiyor' %></strong></td>
              <td><span class="badge bg-secondary badge-category"><%= task.category || 'Yok' %></span></td>
              <td>
                <div class="fw-bold text-light"><%= task.standardisedTitle || task.title %></div>
                <div class="text-secondary small"><%= task.summary || task.body %></div>
                <div class="text-secondary small" style="font-size:0.7em;">Orijinal Text: <%= task.title %> - <%= task.body %></div>
              </td>
              <td>
                <% if(task.urgency === 'Yüksek') { %>
                  <span class="badge bg-danger"><%= task.urgency %></span>
                <% } else if(task.urgency === 'Orta') { %>
                  <span class="badge bg-warning text-dark"><%= task.urgency %></span>
                <% } else { %>
                  <span class="badge bg-info"><%= task.urgency %></span>
                <% } %>
              </td>
              <td>
                <div class="d-flex gap-2">
                  <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#feedbackModal<%= task.id %>">
                    AI'a Yanlışı Söyle
                  </button>
                  <form action="/dashboard/task/archive" method="POST" style="margin: 0;">
                    <input type="hidden" name="taskId" value="<%= task.id %>">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Listeden Gizle">Gizle</button>
                  </form>
                </div>
              </td>
            </tr>

            <!-- Feedback Modal for Task -->
            <div class="modal fade" id="feedbackModal<%= task.id %>" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <form action="/dashboard/feedback" method="POST">
                    <div class="modal-header">
                      <h5 class="modal-title">AI'a Geri Bildirim Ver</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <input type="hidden" name="taskId" value="<%= task.id %>">
                      <input type="hidden" name="originalTitle" value="<%= task.title %>">
                      <input type="hidden" name="originalBody" value="<%= task.body %>">
                      
                      <div class="alert alert-secondary text-light mb-3" style="font-size: 0.9em; background-color: rgba(255,255,255,0.05); border-color: #555;">
                        <strong>Orijinal Müşteri Girdisi:</strong><br>
                        <%= task.title %><br>
                        <%= task.body %><hr class="my-2 border-secondary">
                        <strong>Yapay Zekanın Yaptığı Seçimler:</strong><br>
                        Kategori: <span class="badge bg-secondary"><%= task.category %></span> | 
                        Aciliyet: <span class="badge bg-info text-dark"><%= task.urgency %></span>
                      </div>
                      
                      <div class="mb-3">
                        <label class="form-label">Yapay Zekaya Ne Söylemek İstersiniz?</label>
                        <textarea class="form-control" name="userFeedback" rows="4" placeholder="Örn: Bu görevin kategorisi Yazılım, aciliyeti Yüksek olmalıydı. Çünkü sunucu hatası çok kritiktir." required></textarea>
                        <div class="form-text">Bu mesajınız doğrudan AI'a iletilecek. AI hatasını anlayıp yeni bir JSON üretecek, yeni bir kural (rule) çıkaracak ve görev "Onay Bekleyenler" tabına düşecektir. Oradan inceleyip onaylayabilirsiniz.</div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                      <button type="submit" class="btn btn-success">AI'a Gönder ve Yeniden İşle</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
